# ------------------------------------------------------------------
#  Supabase – zkopíruj z Supabase → Project Settings → API
# ------------------------------------------------------------------

# URL projektu, např. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Veřejný "anon" klíč (jde do prohlížeče, slouží jen pro Realtime)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tajný "service_role" klíč – NIKDY ho nesdílej ani necommituj.
# Používá se výhradně na serveru; díky němu hráči nevidí správné odpovědi.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
#  Přístup do moderátorské části (/admin)
# ------------------------------------------------------------------
ADMIN_PASSWORD=zmen-me
